      "elements": [
        {
          "type": "text",
          "x": 144,
          "y": 68,
          "w": 346,
          "h": 36,
          "text": "STATION TRADE COMMISSION",
          "translations": {
            "zh-Hans": "空间站贸易委员会",
            "zh": "空间站贸易委员会"
          },
          "style": "header",
          "fontSize": 22,
          "align": "center",
          "wrap": false,
          "color": "#35526F",
          "id": "header"
        },
        {
          "type": "text",
          "x": 56,
          "y": 100,
          "w": 524,
          "h": 46,
          "text": "Personal Environment Scanner Appraisal Guide",
          "translations": {
            "zh-Hans": "环境检测仪鉴定指南",
            "zh": "环境检测仪鉴定指南"
          },
          "style": "title",
          "fontSize": 24,
          "align": "center",
          "wrap": false,
          "color": "#35526F",
          "id": "title"
        },
        {
          "type": "text",
          "x": 70,
          "y": 166,
          "w": 506,
          "h": 100,
          "text": "Personal environment scanners are common on the station and their prices vary widely. This guide helps\nfix a fair market value for any of them.\n\nEvery scanner starts at 100¢. The sensor, the body, the module and the maker all move the figure, but\nwhatever its state a scanner is never worth less than 40¢.",
          "translations": {
            "zh-Hans": "空间站上的个人环境检测仪种类繁多，价格也千差万别。本指南将帮助确定任何检测仪的公平市场价值。\n\n所有检测仪的初始价值均为 100¢。传感器、机身、插件与厂商都会影响其价格，但无论状况如何，最低价值为 40¢。",
            "zh": "空间站上的个人环境检测仪种类繁多，价格也千差万别。本指南将帮助确定任何检测仪的公平市场价值。\n\n所有检测仪的初始价值均为 100¢。传感器、机身、插件与厂商都会影响其价格，但无论状况如何，最低价值为 40¢。"
          },
          "style": "title",
          "fontSize": 15,
          "align": "left",
          "wrap": true,
          "color": "#292234"
        },
        {
          "type": "text",
          "x": 70,
          "y": 286,
          "w": 506,
          "h": 26,
          "text": "Base and floor value",
          "translations": {
            "zh-Hans": "基础价值与最低价值",
            "zh": "基础价值与最低价值"
          },
          "style": "label",
          "fontSize": 18,
          "align": "left",
          "wrap": false,
          "color": "#35526F"
        },
        {
          "type": "text",
          "x": 70,
          "y": 320,
          "w": 506,
          "h": 60,
          "text": "Read the four factors in order, then add them up.",
          "translations": {
            "zh-Hans": "四项按顺序核定后相加。",
            "zh": "四项按顺序核定后相加。"
          },
          "style": "title",
          "fontSize": 15,
          "align": "left",
          "wrap": true,
          "color": "#292234"
        },
        {
          "type": "image",
          "x": 226,
          "y": 380,
          "w": 176,
          "h": 220,
          "sprite": "envscan_good_ok",
          "fit": "fit"
        },
        {
          "type": "text",
          "x": 114,
          "y": 606,
          "w": 400,
          "h": 20,
          "text": "Body good, sensor working.",
          "translations": {
            "zh-Hans": "机身良好 · 传感器正常",
            "zh": "机身良好 · 传感器正常"
          },
          "style": "caption",
