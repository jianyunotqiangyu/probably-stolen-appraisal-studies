          "x": 246,
          "y": 480,
          "w": 196,
          "h": 20,
          "text": "Offset (-20¢)",
          "translations": {
            "zh-Hans": "偏移 (-20¢)",
            "zh": "偏移 (-20¢)"
          },
          "style": "caption",
          "fontSize": 15,
          "align": "center",
